# GigaChat API key
GIGACHAT_API_KEY=YOUR_KEY_HERE

# GigaChat model used for text polishing
GIGACHAT_MODEL=GigaChat

# Hotkey format for pynput, example: <ctrl>+<cmd>+s
HOTKEY=<ctrl>+<cmd>+s

# Whisper speech recognition model
WHISPER_MODEL=base

# Optional: custom prompt path
PROMPT_PATH=prompt.md
