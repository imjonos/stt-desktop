# AI Provider: gigachat или openai
AI_PROVIDER=gigachat

# Unified API key (used for both GigaChat and OpenAI)
AI_API_KEY=YOUR_KEY_HERE

# AI model name
AI_MODEL=GigaChat

# Optional: base URL for OpenAI-compatible APIs (e.g., Lamy, local servers)
# AI_BASE_URL=https://api.openai.com/v1

# Legacy GigaChat settings (used for migration if AI_API_KEY is not set)
GIGACHAT_API_KEY=YOUR_KEY_HERE
GIGACHAT_MODEL=GigaChat

# Hotkey format for pynput, example: <ctrl>+<cmd>+s
HOTKEY=<ctrl>+<cmd>+s

# Whisper speech recognition model
WHISPER_MODEL=base

# Set to 1 if your network replaces certificates and Whisper model download fails
WHISPER_SSL_NO_VERIFY=0

# Optional: custom prompt path
PROMPT_PATH=prompt.md

# Prompt modes storage and selected mode
PROMPT_MODES_PATH=prompt_modes.json
ACTIVE_PROMPT_MODE=polish
